                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="CyclistGoStraightStart" delay="0.0" conditionEdge="none">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.1" rule="greaterThan"/>
