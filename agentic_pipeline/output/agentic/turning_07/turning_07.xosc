<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="turning: turn_right_into_parking vs go_straight. A truck turning right into a parking lot collided with a cyclist on a separated bike path." author="Shayma" revMajor="1" revMinor="3" date="2026-08-26T17:06:25.808629"/>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="straight_road.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="truck_1">
            <Vehicle name="truck_1" vehicleCategory="truck" model3d="truck_yellow.osgb">
                <BoundingBox>
                    <Center x="1.5" y="0.0" z="1.2"/>
                    <Dimensions width="2.5" length="8.0" height="3.0"/>
                </BoundingBox>
                <Performance maxSpeed="30.0" maxDeceleration="6.0" maxAcceleration="4.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.8" trackWidth="2.0" positionX="5.5" positionZ="0.4"/>
                    <RearAxle maxSteering="0.5" wheelDiameter="0.8" trackWidth="2.0" positionX="0.0" positionZ="0.4"/>
                </Axles>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="cyclist_1">
            <Vehicle name="cyclist_1" vehicleCategory="bicycle" model3d="cyclist.osgb">
                <BoundingBox>
                    <Center x="0.3" y="0.0" z="0.8"/>
                    <Dimensions width="0.6" length="1.8" height="1.5"/>
                </BoundingBox>
                <Performance maxSpeed="15.0" maxDeceleration="4.0" maxAcceleration="3.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.0" wheelDiameter="0.3" trackWidth="0.5" positionX="1.2" positionZ="0.15"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.3" trackWidth="0.5" positionX="0.0" positionZ="0.15"/>
                </Axles>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="truck_1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-1" s="230.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="1.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="10.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="cyclist_1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-2" s="50.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="1.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="4.25"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="story_act_maneuvuergroup_MotorVehicleManeuverManeuver">
            <Act name="act_maneuvuergroup_MotorVehicleManeuverManeuver">
                <ManeuverGroup name="maneuvuergroup_MotorVehicleManeuverManeuver" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="truck_1"/>
                    </Actors>
                    <Maneuver name="MotorVehicleManeuverManeuver">
                        <Event name="MotorVehicleManeuverEvent" priority="override" maximumExecutionCount="1">
                            <Action name="MotorVehicleManeuverFollowTrajectory">
                                <PrivateAction>
                                    <RoutingAction>
                                        <FollowTrajectoryAction>
                                            <TrajectoryRef>
                                                <Trajectory name="MotorVehicleTrajectory" closed="false">
                                                    <Shape>
                                                        <Polyline>
                                                            <Vertex time="0.0">
                                                                <Position>
                                                                    <WorldPosition x="-13.422478299554822" y="14.90614978114668" z="0.0" h="-0.9143237588575397" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="6.8">
                                                                <Position>
                                                                    <WorldPosition x="-6.098561506855926" y="5.4003492986190205" z="0.0" h="-0.9143237588575397" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="7.8">
                                                                <Position>
                                                                    <WorldPosition x="-4.016966201231132" y="2.2070812260011348" z="0.0" h="-1.1640803748179283" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="8.5">
                                                                <Position>
                                                                    <WorldPosition x="-3.3425260617639325" y="-1.0604454377424806" z="0.0" h="-2.0138811876139675" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="9.0">
                                                                <Position>
                                                                    <WorldPosition x="-2.926994398578307" y="-2.255156045751871" z="0.0" h="-2.4851200856524365" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="10.0">
                                                                <Position>
                                                                    <WorldPosition x="-2.926994398578307" y="-2.255156045751871" z="0.0" h="-2.4851200856524365" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                        </Polyline>
                                                    </Shape>
                                                </Trajectory>
                                            </TrajectoryRef>
                                            <TimeReference>
                                                <Timing domainAbsoluteRelative="relative" scale="1.0" offset="0.0"/>
                                            </TimeReference>
                                            <TrajectoryFollowingMode followingMode="position"/>
                                        </FollowTrajectoryAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="MotorVehicleManeuverStart" delay="0.0" conditionEdge="none">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.1" rule="greaterThan"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="act_start" delay="0.0" conditionEdge="rising">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger/>
            </Act>
        </Story>
        <Story name="story_act_maneuvuergroup_CyclistGoStraightManeuver">
            <Act name="act_maneuvuergroup_CyclistGoStraightManeuver">
                <ManeuverGroup name="maneuvuergroup_CyclistGoStraightManeuver" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
