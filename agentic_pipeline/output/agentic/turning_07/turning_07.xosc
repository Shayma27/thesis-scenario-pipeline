                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="10.0">
                                                                <Position>
                                                                    <WorldPosition x="-2.926994398578307" y="-2.255156045751871" z="0.0" h="-0.9143237588575397" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                        </Polyline>
                                                    </Shape>
                                                </Trajectory>
                                            </TrajectoryRef>
                                            <TimeReference>
                                                <Timing domainAbsoluteRelative="relative" scale="1.0" offset="0.0"/>
                                            </TimeReference>
                                            <TrajectoryFollowingMode followingMode="position"/>
                                        </FollowTrajectoryAction>
                                    </RoutingAction>
                                </PrivateAction>
