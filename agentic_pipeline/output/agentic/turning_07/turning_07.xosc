                    <Maneuver name="CyclistGoStraightManeuver">
                        <Event name="CyclistGoStraightEvent" priority="override" maximumExecutionCount="1">
                            <Action name="CyclistGoStraightFollowTrajectory">
                                <PrivateAction>
                                    <RoutingAction>
                                        <FollowTrajectoryAction>
                                            <TrajectoryRef>
                                                <Trajectory name="CyclistGoStraightTrajectory" closed="false">
                                                    <Shape>
                                                        <Polyline>
                                                            <Vertex time="0.0">
                                                                <Position>
                                                                    <WorldPosition x="-124.99227427689337" y="156.17485199637568" z="0.0" h="-0.9143237588575397" p="0.0" r="0.0"/>
                                                                </Position>
