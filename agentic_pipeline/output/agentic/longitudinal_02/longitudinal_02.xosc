<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="longitudinal: go_straight vs change_lane. A cyclist changed from the bike lane to the adjacent car lane and collided with a car traveling in the same direction." author="Shayma" revMajor="1" revMinor="3" date="2026-08-26T16:56:38.161156"/>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="straight_road.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="car_1">
            <Vehicle name="car_1" vehicleCategory="car" model3d="car_red.osgb">
                <BoundingBox>
                    <Center x="1.3" y="0.0" z="0.8"/>
                    <Dimensions width="1.8" length="4.5" height="1.6"/>
                </BoundingBox>
                <Performance maxSpeed="50.0" maxDeceleration="8.0" maxAcceleration="8.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.6" positionX="3.0" positionZ="0.3"/>
                    <RearAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.6" positionX="0.0" positionZ="0.3"/>
                </Axles>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="cyclist_1">
            <Vehicle name="cyclist_1" vehicleCategory="bicycle" model3d="cyclist.osgb">
                <BoundingBox>
                    <Center x="0.3" y="0.0" z="0.8"/>
                    <Dimensions width="0.6" length="1.8" height="1.5"/>
                </BoundingBox>
                <Performance maxSpeed="15.0" maxDeceleration="4.0" maxAcceleration="3.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.0" wheelDiameter="0.3" trackWidth="0.5" positionX="1.2" positionZ="0.15"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.3" trackWidth="0.5" positionX="0.0" positionZ="0.15"/>
                </Axles>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="car_1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-1" s="225.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="1.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="10.0"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="cyclist_1">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-2" s="50.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="1.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="4.25"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="story_act_maneuvuergroup_MotorVehicleManeuverManeuver">
            <Act name="act_maneuvuergroup_MotorVehicleManeuverManeuver">
                <ManeuverGroup name="maneuvuergroup_MotorVehicleManeuverManeuver" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="car_1"/>
                    </Actors>
                    <Maneuver name="MotorVehicleManeuverManeuver">
                        <Event name="MotorVehicleManeuverEvent" priority="override" maximumExecutionCount="1">
                            <Action name="MotorVehicleManeuverFollowTrajectory">
                                <PrivateAction>
                                    <RoutingAction>
                                        <FollowTrajectoryAction>
                                            <TrajectoryRef>
                                                <Trajectory name="MotorVehicleTrajectory" closed="false">
                                                    <Shape>
                                                        <Polyline>
                                                            <Vertex time="0.0">
                                                                <Position>
                                                                    <WorldPosition x="-1.0159204909624437" y="-25.026468599385783" z="0.0" h="1.4689017457284717" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="6.8">
                                                                <Position>
                                                                    <WorldPosition x="0.7132914998168152" y="-8.114643568037296" z="0.0" h="1.4689017457284717" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="7.8">
                                                                <Position>
                                                                    <WorldPosition x="1.3982652100736266" y="-4.364868772631953" z="0.0" h="1.178196082001634" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="8.5">
                                                                <Position>
                                                                    <WorldPosition x="3.1558475934916577" y="-1.5289378557197328" z="0.0" h="0.18906549032729947" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="9.0">
                                                                <Position>
                                                                    <WorldPosition x="3.6758349112254503" y="-0.3758493121134923" z="0.0" h="-0.3594357619874886" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="10.0">
                                                                <Position>
                                                                    <WorldPosition x="3.6758349112254503" y="-0.3758493121134923" z="0.0" h="-0.3594357619874886" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                        </Polyline>
                                                    </Shape>
                                                </Trajectory>
                                            </TrajectoryRef>
                                            <TimeReference>
                                                <Timing domainAbsoluteRelative="relative" scale="1.0" offset="0.0"/>
                                            </TimeReference>
                                            <TrajectoryFollowingMode followingMode="position"/>
                                        </FollowTrajectoryAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="MotorVehicleManeuverStart" delay="0.0" conditionEdge="none">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.1" rule="greaterThan"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="act_start" delay="0.0" conditionEdge="rising">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger/>
            </Act>
        </Story>
        <Story name="story_act_maneuvuergroup_CyclistGoStraightManeuver">
            <Act name="act_maneuvuergroup_CyclistGoStraightManeuver">
