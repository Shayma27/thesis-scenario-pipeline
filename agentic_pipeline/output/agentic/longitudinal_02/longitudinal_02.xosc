                                                                </Position>
                                                            </Vertex>
                                                            <Vertex time="10.0">
                                                                <Position>
                                                                    <WorldPosition x="3.6758349112254503" y="-0.3758493121134923" z="0.0" h="1.4689017457284717" p="0.0" r="0.0"/>
                                                                </Position>
                                                            </Vertex>
                                                        </Polyline>
                                                    </Shape>
                                                </Trajectory>
                                            </TrajectoryRef>
                                            <TimeReference>
                                                <Timing domainAbsoluteRelative="relative" scale="1.0" offset="0.0"/>
                                            </TimeReference>
                                            <TrajectoryFollowingMode followingMode="position"/>
